<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SwingUI.FriendsMenuUI">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="600" height="500"/>
    </constraints>
    <properties>
      <background color="-526345"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="combo1" class="javax.swing.JComboBox" binding="addFriendCombo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-13421773"/>
        </properties>
      </component>
      <component id="btn1" class="javax.swing.JButton" binding="addFriendBtn">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-16745804"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-1"/>
          <text value="Add Friend"/>
        </properties>
      </component>
      <component id="combo2" class="javax.swing.JComboBox" binding="viewFriendCombo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-13421773"/>
        </properties>
      </component>
      <component id="btn2" class="javax.swing.JButton" binding="viewPostsBtn">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-16745804"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-1"/>
          <text value="View Friends Posts"/>
        </properties>
      </component>
      <scrollpane id="scroll">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="area" class="javax.swing.JTextArea" binding="postsDisplayArea">
            <constraints/>
            <properties>
              <background color="-1"/>
              <editable value="false"/>
              <font name="Segoe UI" size="14"/>
              <foreground color="-13421773"/>
              <margin top="10" left="10" bottom="10" right="10"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="btn3" class="javax.swing.JButton" binding="backBtn">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-2631721"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-13421773"/>
          <text value="Back to Main Menu"/>
        </properties>
      </component>
      <component id="btn4" class="javax.swing.JButton" binding="helpBtn">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="35"/>
          </grid>
        </constraints>
        <properties>
          <background color="-16089257"/>
          <font name="Segoe UI" size="14"/>
          <foreground color="-13421773"/>
          <text value="Help"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
