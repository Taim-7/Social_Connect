<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="SwingUI.IntroScreenUI">
  <grid id="27dc6" binding="introPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="15">
    <margin top="40" left="20" bottom="40" right="20"/>
    <constraints>
      <xy x="20" y="20" width="400" height="300"/>
    </constraints>
    <properties>
      <background color="-526345"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="title" class="javax.swing.JLabel" binding="titleLbl">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="34" style="1"/>
          <foreground color="-16745804"/>
          <text value="Social Connect"/>
        </properties>
      </component>
      <component id="loading" class="javax.swing.JLabel" binding="loadingLbl">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="16"/>
          <foreground color="-10066330"/>
          <text value="Loading system... please wait."/>
        </properties>
      </component>
    </children>
  </grid>
</form>
